# Django Core Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP Email Configuration
# To enable real SMTP delivery (e.g. Gmail):
# 1. Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# 2. Set EMAIL_HOST=smtp.gmail.com
# 3. Set EMAIL_PORT=587
# 4. Set EMAIL_USE_TLS=True
# 5. Set EMAIL_HOST_USER=your-email@gmail.com
# 6. Set EMAIL_HOST_PASSWORD=your-app-password
# 7. Set DEFAULT_FROM_EMAIL=your-email@gmail.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
