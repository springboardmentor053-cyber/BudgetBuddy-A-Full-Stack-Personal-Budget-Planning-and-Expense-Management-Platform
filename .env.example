# =====================================================
# DJANGO BACKEND ENVIRONMENT VARIABLES
# =====================================================

# Security (Generate a secure key in production)
DJANGO_SECRET_KEY=your-production-secret-key-at-least-50-characters-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,your-api.onrender.com

# Database (PostgreSQL URL in production, SQLite used if omitted)
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://budgetbuddy_user:password@dpg-xxx.oregon-postgres.render.com/budgetbuddy

# CORS & CSRF (Include your frontend Vercel domain and backend Render domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-api.onrender.com

# Email Configuration (Optional SMTP / Gmail / Resend)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# =====================================================
# REACT FRONTEND ENVIRONMENT VARIABLES (Vercel / .env.local)
# =====================================================
VITE_API_URL=https://your-api.onrender.com/api/
